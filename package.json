{
  "name": "stream-launcher",
  "productName": "Stream Pack Launcher",
  "version": "1.0.0",
  "description": "OBS Auto-Setup Launcher",
  "main": "main.js",
  "scripts": {
    "start": "chcp 65001>nul & electron .",
    "build": "electron-builder --win"
  },
  "dependencies": {
    "localtunnel": "^2.0.2",
    "obs-websocket-js": "^5.0.5",
    "tmi.js": "^1.8.5"
  },
  "devDependencies": {
    "electron": "^29.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.bagerca.streamlauncher",
    "asar": false,
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "runAfterFinish": true
    }
  }
}